# ── Native LLM client (default /query path — backend/llm_client.py) ──────────
# The /query endpoint uses the native client UNLESS LLM_PROVIDER=litellm.
# LLM_PROVIDER: one of ollama / openai / anthropic (default: ollama).
LLM_PROVIDER=ollama
# OLLAMA_MODEL: the native client's default is llama3.2 — override it to a model
# you have actually pulled (`ollama pull <model>`), e.g. llama3.1:8b.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ── LiteLLM Gateway Config (only used when LLM_PROVIDER=litellm) ─────────────
# Primary provider: one of openai / anthropic / groq / gemini / ollama
LITELLM_PRIMARY_PROVIDER=openai
LITELLM_PRIMARY_MODEL=gpt-4o-mini

# Fallback provider (used if primary fails)
LITELLM_FALLBACK_PROVIDER=anthropic
LITELLM_FALLBACK_MODEL=claude-sonnet-4-20250514

# API keys (set per provider you use)
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
GROQ_API_KEY=gsk_your_key_here
GEMINI_API_KEY=your_gemini_key
# OLLAMA needs no key (OLLAMA_BASE_URL is set in the native section above).

# Optional: API base overrides for self-hosted or proxy endpoints
LITELLM_OPENAI_BASE_URL=
LITELLM_ANTHROPIC_BASE_URL=

# ── Rate limit / retry ──────────────────────────────────────────────────────
LITELLM_MAX_RETRIES=3
LITELLM_TIMEOUT=60