# ── LiteLLM Gateway Config ──────────────────────────────────────────────────
# Primary provider: one of openai / anthropic / groq / gemini / ollama
LITELLM_PRIMARY_PROVIDER=openai
LITELLM_PRIMARY_MODEL=gpt-4o-mini

# Fallback provider (used if primary fails)
LITELLM_FALLBACK_PROVIDER=anthropic
LITELLM_FALLBACK_MODEL=claude-sonnet-4-20250514

# API keys (set per provider you use)
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
GROQ_API_KEY=gsk_your_key_here
GEMINI_API_KEY=your_gemini_key
# OLLAMA needs no key but set OLLAMA_BASE_URL if non-default
OLLAMA_BASE_URL=http://localhost:11434

# Optional: API base overrides for self-hosted or proxy endpoints
LITELLM_OPENAI_BASE_URL=
LITELLM_ANTHROPIC_BASE_URL=

# ── Rate limit / retry ──────────────────────────────────────────────────────
LITELLM_MAX_RETRIES=3
LITELLM_TIMEOUT=60